shader_parameter/use_color_gradient = true
shader_parameter/color_gradient = ExtResource("3_wyl6v")
shader_parameter/shadow_color = Color(0.45, 0.45, 0.5, 1)
shader_parameter/shadow_threshold = 0.2
shader_parameter/shadow_softness = 0.02
shader_parameter/use_fresnel = true
